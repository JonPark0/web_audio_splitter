USE_GPU=false
DEMUCS_SHIFTS=0

# --- Recovery stage (frequency restoration, opt-in per job) ---
# AudioSR sampling quality/speed tradeoff: higher = slower, generally better.
AUDIOSR_DDIM_STEPS=50
AUDIOSR_GUIDANCE_SCALE=3.5
# "basic" (music/general) or "speech"
AUDIOSR_MODEL_NAME=basic

# --- Storage ---
# Delete jobs (uploaded audio, stems, spectrograms) older than this many days.
# Library samples are separate copies and are never deleted by this. 0 = keep all.
MEDIA_RETENTION_DAYS=0
# Largest accepted upload (MB). Longer than 30 minutes is refused regardless.
MAX_UPLOAD_MB=1024
# Disk cap for cached time-stretch/pitch renders (MB); least recently used
# ones are deleted past it (they're re-made on use).
RENDER_CACHE_MB=4096

# --- Job queue ---
# Separation jobs run one at a time by default: two at once on one GPU tend to
# run out of memory. Raise only with the VRAM (or CPU cores) to spare.
MAX_CONCURRENT_JOBS=1

# --- Database (PostgreSQL 18, docker compose service "db") ---
# Only reachable inside the compose network by default; change the password
# if you publish port 5432 (see docker-compose.*.yml).
POSTGRES_USER=splitter
POSTGRES_PASSWORD=splitter
POSTGRES_DB=splitter
